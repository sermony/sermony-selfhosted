# Sermony.Recorder — Deploy-Konfiguration (Vorlage).
#
# NICHT direkt bearbeiten und einchecken — ./scripts/setup.sh erzeugt daraus
# interaktiv deploy/.env (chmod 600, gitignored) und bewahrt bei Re-Runs
# bestehende Werte. ./scripts/upgrade.sh trägt neu hinzugekommene Keys nach.

# ── Sermony-Anbindung (Pflicht) ───────────────────────────────────────────────
# Webapp-URL, gegen die sich der Recorder per WebSocket verbindet (https!).
SERMONY_HOST=
# Aus der Sermony-Webapp: Einstellungen → Recorder → ID + Token.
RECORDER_ID=
RECORDER_TOKEN=

# ── Sicherheit ────────────────────────────────────────────────────────────────
# API-Key der Recorder-API (Port 5000) für externe Clients. setup.sh generiert
# ihn automatisch; interne Services nutzen die IP-Allowlist + RECORDER_TOKEN.
API_KEY=

# ── Allgemein ─────────────────────────────────────────────────────────────────
TZ=Europe/Berlin
DEBUG=false
# 1 = Mono (Predigt-Standard), 2 = Stereo
AUDIO_CHANNELS=1
# Image-Referenz; für reproduzierbare Deployments auf Digest pinnen.
RECORDER_IMAGE=ghcr.io/sermony/recorder:stable

# ── Optionale Bausteine ───────────────────────────────────────────────────────
# ESP32-Display angeschlossen? Dann: COMPOSE_PROFILES=esp32 (setup.sh fragt).
COMPOSE_PROFILES=

# ── Display-Firmware-Updates (nur mit esp32-Profil relevant) ─────────────────
# Update-Kanal: stable (Default) oder dev (Testgeräte).
SCREEN_UPDATE_CHANNEL=stable
# Basis-URL des Update-Servers; leer = https://scp.sermony.de/api/recorder-screen-updates
SCREEN_UPDATE_URL=
# Host-Ordner: hier abgelegte screen-update-*.tar.gz werden automatisch
# verifiziert + installiert (Offline-Updates). Ergebnis in done/ bzw. failed/.
SCREEN_PICKUP_DIR=/opt/sermony-recorder/screen-pickup

# ── Upload-Ziel (ADR-029) ─────────────────────────────────────────────────────
# SERMONY_UPLOAD=1 → Aufnahmen gehen an die Instanz aus SERMONY_HOST. Ziel-URL und
# Token weist Sermony pro Aufnahme zu (resumierbarer Upload); eine feste UPLOAD_URL
# gibt es nicht mehr. Auth laeuft ueber RECORDER_ID + RECORDER_TOKEN.
# Alternativ WebDAV (W_*). Beides aus ⇒ Aufnahmen bleiben nur auf dem Geraet.
SERMONY_UPLOAD=1
W_HOST=
W_USERNAME=
W_PASSWORD=
W_PATH=/

# ── ID3-Metadaten für konvertierte Aufnahmen (optional) ──────────────────────
META_ORGANIZATION=
META_LANGUAGE=German
META_WEBSITE=
META_ARTIST=
META_ALBUM=
META_COMPOSER=
TITLE_PREFIX=
